  "home": {"part": "MODEL"},
  "quick_access": true,
  "ribbon_overflow": "whole_panels",
  "view_cube": {"edges": true, "compass": true},
  "letter_keys": "aliases",
  "alias_wait_ms": 750,
  "function_keys": {"F5": "ui.view_previous", "F6": "ui.view_home"},
