                 "evidence": "docs/evidence/screenshots/marking-menus/body-crop.png",
                 "unmapped": ["list: Select Tangencies (no tangent-face selection)", "list: Make Part", "list: Create Note", "list: Hide Others", "list: Export Object", "list: Help Topics…"]},
      "empty":  {"ring": ["solid.fillet", "solid.extrude", "solid.revolve", "solid.hole", "sketch.create", "construct.plane.offset", "edit.undo", "inspect.measure"],
                 "overflow": ["ui.repeat", "-", "ui.showAll", "-", "ui.previousView", "ui.home"],
