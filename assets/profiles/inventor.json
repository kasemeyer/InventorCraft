    {"keys": "R", "command": "solid.revolve", "scope": "model"},
    {"keys": "RP", "command": "solid.pattern.rectangular", "scope": "model"},
    {"keys": "SH", "command": "solid.shell", "scope": "model"},
    {"keys": "SW", "command": "solid.sweep", "scope": "model"},
    {"keys": "TH", "command": "solid.thread", "scope": "model"},
    {"keys": "FO", "command": "sheet.fold", "scope": "part"},
    {"keys": "HEM", "command": "sheet.hem", "scope": "part"},
    {"keys": "ST", "command": "sheet.manage_rules", "scope": "part"},
