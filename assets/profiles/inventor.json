                 "overflow": ["ui.repeat", "-", "inspect.measure", "-", "ui.showAll", "-", "ui.previousView", "ui.home"],
                 "evidence": "docs/evidence/screenshots/marking-menus/sketch-empty-crop.png",
                 "unmapped": ["list: Create Feature", "list: Slice Graphics", "list: Dimension Display", "list: Region Properties", "list: Sketch Doctor", "list: Select Broken Projections", "list: Hide Others", "list: Place Feature…", "list: Help Topics…"]},
      "sketch_line": {"ring": ["ui.delete", "", "sketch.construction", "", "sketch.centerline", "", "edit.undo", ""],
                 "overflow": ["ui.repeat", "-", "ui.copy", "-", "ui.finishSketch", "-", "inspect.measure", "-", "ui.lookAt", "ui.previousView", "ui.home"],
                 "evidence": "docs/evidence/screenshots/marking-menus/sketch-line-crop.png",
                 "unmapped": ["list: Display Degrees of Freedom", "list: Snap to Grid", "list: Close Loop", "list: Show All Constraints", "list: Properties…", "list: Slice Graphics", "list: Region Properties", "list: Create Note", "list: Show Input", "list: Adaptive", "list: Find in Browser", "list: Help Topics…"]},
      "sketch_dimension": {"ring": ["ui.delete", "", "sketch.toggle_driven", "", "", "", "edit.undo", ""],
                 "overflow": ["ui.repeat", "-", "ui.finishSketch", "-", "inspect.measure", "-", "ui.previousView", "ui.home"],
                 "evidence": "docs/evidence/screenshots/marking-menus/sketch-dimension-crop.png",
                 "unmapped": ["S: Dimension Properties…", "list: Flip Direction", "list: Snap to Grid", "list: Show All Constraints", "list: Promote", "list: Slice Graphics", "list: Region Properties", "list: Create Note", "list: Adaptive", "list: Export Object", "list: Find in Browser", "list: Help Topics…"]},
