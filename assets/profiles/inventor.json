    "part_root": ["named_views", "bodies", "origin", "history", "canvases", "analyses", "components", "doc_settings"],
    "assembly_root": ["named_views", {"node": "joints", "always": true}, "origin", "canvases", "analyses", "bodies", "sketches", "construction", "features", "components", "doc_settings"],
    "folder_labels": {
