{
  "format": "tci-ui-profile/1",
  "id": "inventor",
  "name": "profile.inventor",
  "defaults": {"version": 2, "nav": "inventor", "navigator": "cube", "theme": "tci-dark", "history": "browser", "units": "in", "new_document": "part"},
  "workflow": {
    "look_at_on_sketch": true,
    "restore_view_after_sketch": true,
    "escape_twice_finishes_sketch": false,
    "sketch_palette": false,
    "template_values": true,
    "inch_length_decimals": 3,
    "mm_length_decimals": 2,
    "apply_and_continue": true,
    "status_bar": true,
    "show_panels_menu": true,
    "sectioned_extrude": true,
    "plane_drag": true,
    "sticky_split_buttons": true,
    "origin_auto_hide": true,
    "marking_menu": {
      "face":   {"ring": ["ui.lookAt", "solid.extrude", "ui.selectOther", "", "sketch.create", "construct.plane.offset", "edit.undo", "inspect.measure"],
