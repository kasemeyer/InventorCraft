                 "unmapped": ["list: Point Snaps", "list: Coordinate Type", "list: Autoproject", "list: Construction (style of the next curve)", "list: Centerline (style of the next curve)", "list: How To…"]},
      "panel":  {"ring": ["ui.applyContinue", "", "", "", "ui.home", "", "ui.cancel", ""],
                 "overflow": ["ui.ok", "-", "ui.previousView"],
                 "evidence": "docs/evidence/screenshots/marking-menus/feature-dialog-open-crop.png",
                 "unmapped": ["E: Continue", "list: How To…"]},
      "assembly_component": {"ring": ["", "", "", "", "", "", "edit.undo", "inspect.measure"],
                 "overflow": ["ui.repeat", "-", "ui.delete", "-", "solid.move"],
                 "evidence": "docs/evidence/screenshots/marking-menus/assembly-component-crop.png",
                 "unmapped": ["N: Open", "NE: Constraint", "E: Show Relationships", "SE: Visibility", "S: Edit", "SW: Find in Browser", "list: Copy", "list: Add to New Folder", "list: Selection", "list: Isolate", "list: Undo Isolate", "list: Free Rotate", "list: Substitute", "list: Representation…", "list: Component", "list: Create Note", "list: BOM Structure", "list: Visibility", "list: iMate Glyph Visibility", "list: Grounded", "list: Adaptive", "list: Enabled", "list: Transparent", "list: Contact Set", "list: Suppress", "list: Instance Properties…", "list: iProperties…", "list: AEC Properties…", "list: How To…"]},
      "assembly_empty": {"ring": ["component.insert_design", "", "", "solid.move", "component.create", "", "edit.undo", "inspect.measure"],
                 "overflow": ["joint.create", "-", "ui.previousView", "ui.home"],
                 "evidence": "docs/evidence/screenshots/marking-menus/assembly-empty-crop.png",
                 "unmapped": ["NE: Constraint", "E: Pattern Component", "SW: Free Rotate", "list: Replace from Content Center…", "list: Make Layout", "list: Create Pipe Run…", "list: Create Harness…", "list: Assemble", "list: Show Relationships", "list: Hide All", "list: Create iMate", "list: Dimension Display", "list: Help Topics…"]}
