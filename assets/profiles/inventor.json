    {"keys": "PO", "command": "sketch.point", "scope": "sketch_wrapper"},
    {"keys": "POL", "command": "sketch.polygon.inscribed", "scope": "sketch"},
    {"keys": "REC", "command": "sketch.rectangle.two_point", "scope": "sketch"},
    {"keys": "REC3", "command": "sketch.rectangle.three_point", "scope": "sketch"},
    {"keys": "RP", "command": "sketch.pattern.rectangular", "scope": "sketch"},
    {"keys": "SP", "command": "sketch.spline.fit_point", "scope": "sketch_wrapper"},
    {"keys": "TC", "command": "sketch.circle.three_tangent", "scope": "sketch"},
    {"keys": "X", "command": "sketch.trim", "scope": "sketch_wrapper"},
    {"keys": "CH", "command": "solid.chamfer", "scope": "model"},
    {"keys": "E", "command": "solid.extrude", "scope": "model"},
    {"keys": "F", "command": "solid.fillet", "scope": "model"},
